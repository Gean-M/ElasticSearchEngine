# Copie para .env (ou exporte diretamente no terminal) ao rodar o backend
# fora do Docker, com `npm run dev` - ver seção "Desenvolvimento local" do
# README principal. Dentro do docker-compose, essas variáveis já são
# definidas automaticamente (docker/docker-compose.yml + docker/.env).

PORT=4000

ES_SCHEME=https
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=user123
ES_INDEX=wikipedia
ES_TRUST_ALL_CERTS=true
